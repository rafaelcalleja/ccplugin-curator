{
  "name": "curated-plugin",
  "commands": [
    "commands/build.md"
  ],
  "agents": [
    "agents/documentation-writer.md",
    "agents/code-reviewer.md"
  ],
  "skills": [
    "skills/skill-b"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "type": "agent",
        "agent": "/code-reviewer",
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "/cleanup"
      }
    ]
  },
  "mcpServers": {
    "data-processor": {
      "command": "node",
      "args": [
        "dist/mcp-server.js"
      ],
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}