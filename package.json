{
  "name": "ccplugin-curator",
  "version": "0.0.1",
  "description": "Claude Code Plugin Curator - TUI for selecting and curating plugin components",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "ccplugin-curator": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "generate-types": "json-schema-to-typescript schemas/plugin.schema.json -o src/types/plugin.ts && json-schema-to-typescript schemas/normalized-plugin.schema.json -o src/types/normalized.ts",
    "test": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:setup-fixtures": "node scripts/setup-fixtures.js",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "curator",
    "tui",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "json-schema-to-typescript": "^13.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "commander": "^11.0.0",
    "glob": "^10.0.0",
    "ink": "^4.0.0",
    "react": "^18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
