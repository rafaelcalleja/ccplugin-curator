{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/setup-env.sh"
        },
        {
          "type": "command",
          "command": "/init-workspace.sh"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "/security-check.sh"
        }
      ]
    },
    {
      "matcher": "Write",
      "hooks": [
        {
          "type": "command",
          "command": "/cleanup.sh"
        }
      ]
    }
  ]
}
