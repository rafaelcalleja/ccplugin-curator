{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.com/schemas/normalized-plugin.json",
  "title": "Normalized Plugin",
  "description": "Internal normalized plugin format used by curator",
  "type": "object",
  "required": [
    "name",
    "source",
    "version",
    "description",
    "author",
    "homepage",
    "repository",
    "license",
    "keywords",
    "commands",
    "agents",
    "skills",
    "hooks",
    "mcps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Plugin name"
    },
    "source": {
      "type": "string",
      "description": "Absolute path to plugin directory"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (default: 0.0.0)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Plugin description (default: empty string)"
    },
    "author": {
      "type": "object",
      "required": ["name", "email", "url"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      },
      "description": "Author info (default: all empty strings)"
    },
    "homepage": {
      "type": "string",
      "description": "Homepage URL (default: empty string)"
    },
    "repository": {
      "type": "string",
      "description": "Repository URL (default: empty string)"
    },
    "license": {
      "type": "string",
      "description": "License (default: empty string)"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keywords (default: empty array)"
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Command file paths (relative, always array)"
    },
    "agents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Agent file paths (relative, always array)"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Skill directory paths (relative, always array)"
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "type", "command"],
        "properties": {
          "event": {
            "type": "string",
            "description": "Hook event name"
          },
          "type": {
            "type": "string",
            "const": "command",
            "description": "Hook type (only command supported)"
          },
          "command": {
            "type": "string",
            "description": "Command to execute"
          },
          "matcher": {
            "type": "string",
            "description": "Optional matcher pattern"
          },
          "timeout": {
            "type": "number",
            "description": "Optional timeout in seconds"
          }
        },
        "additionalProperties": true
      },
      "description": "Hooks (flat array, always array)"
    },
    "mcps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": {
            "type": "string",
            "description": "MCP server name"
          },
          "command": {
            "type": "string",
            "description": "Executable command"
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Command arguments"
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Environment variables"
          }
        },
        "additionalProperties": true
      },
      "description": "MCP servers (flat array, always array)"
    }
  }
}
