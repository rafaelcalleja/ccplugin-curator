{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rafaelcalleja/ccplugin-curator/schemas/plugin.schema.json",
  "title": "Claude Code Plugin (Official Format)",
  "description": "Official plugin.json format for Claude Code plugins",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plugin name (kebab-case recommended)"
    },
    "version": {
      "type": "string",
      "description": "Semantic version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Brief explanation of the plugin's purpose"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "URL to plugin documentation"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "URL to source code repository"
    },
    "license": {
      "type": "string",
      "description": "License identifier (SPDX format recommended)"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for discovery"
    },
    "commands": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to directory or file glob pattern"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of explicit file paths"
        }
      ]
    },
    "agents": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to directory or file glob pattern"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of explicit file paths"
        }
      ]
    },
    "skills": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to skills directory"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of skill directory paths"
        }
      ]
    },
    "hooks": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to hooks.json file"
        },
        {
          "type": "object",
          "description": "Inline hooks configuration",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "matcher": {
                  "type": "string"
                },
                "hooks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["command"]
                      },
                      "command": {
                        "type": "string"
                      },
                      "timeout": {
                        "type": "number"
                      }
                    },
                    "required": ["type", "command"],
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "mcpServers": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to .mcp.json file"
        },
        {
          "type": "object",
          "description": "Inline MCP servers configuration",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["command"],
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
