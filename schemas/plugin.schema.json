{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code Plugin (Official Format)",
  "description": "Official plugin.json format for Claude Code plugins",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plugin name (kebab-case format)"
    },
    "version": {
      "type": "string",
      "description": "Semantic version"
    },
    "description": {
      "type": "string",
      "description": "Brief explanation of the plugin's purpose"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "homepage": {
      "type": "string",
      "description": "URL of documentation"
    },
    "repository": {
      "type": "string",
      "description": "URL of source code"
    },
    "license": {
      "type": "string",
      "description": "License identifier"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Discovery tags"
    },
    "commands": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Command files or directories"
    },
    "agents": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Agent files or directories"
    },
    "skills": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Skill directories"
    },
    "hooks": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "description": "Hook configuration file path or inline configuration"
    },
    "mcpServers": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "description": "MCP servers configuration file path or inline configuration"
    }
  }
}
